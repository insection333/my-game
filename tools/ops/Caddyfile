# The site's front door (installed to /etc/caddy/Caddyfile by setup.sh). Caddy fetches and renews the
# HTTPS certificates itself once the domain points at this server.
idleclash.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:3000
	# No access log (session 238): it kept every visitor's connection address on disk, where the privacy
	# page says the address is used a short while and not kept. Caddy's own errors go to its journal.
}

www.idleclash.com {
	redir https://idleclash.com{uri} permanent
}
